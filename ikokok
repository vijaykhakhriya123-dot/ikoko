def generate_qr_code(text):
    try:
        encoded_data = urllib.parse.quote(text)
        api_url = f"https://api.qrserver.com/v1/create-qr-code/?size=300x300&data={encoded_data}"
        r = requests.get(api_url, timeout=10)
        if r.status_code == 200:
            file_name = f"qr_{random.randint(1000, 9999)}.png"
            with open(file_name, "wb") as f:
                f.write(r.content)
            return file_name
    except Exception:
        pass
    return None

def extract_ocr_text(image_url):
    try:
        encoded_url = urllib.parse.quote(image_url)
        api_url = f"https://api.ocr.space/parse/imageurl?apikey=helloworld&url={encoded_url}"
        r = requests.get(api_url, timeout=15)
        if r.status_code == 200:
            data = r.json()
            results = data.get("ParsedResults", [])
            if results:
                parsed_text = results[0].get("ParsedText", "").strip()
                return parsed_text if parsed_text else "No text found in image."
    except Exception as e:
        return f"OCR Error: {e}"
    return "Failed to parse OCR image."

