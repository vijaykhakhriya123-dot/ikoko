                    if k.startswith(key_prefix): ACTIVE_AUTOPING_CHANNELS[k] = False

                if c_id in SPAM_STOP_EVENTS: SPAM_STOP_EVENTS[c_id].set()
                if c_id in SPAM2_STOP_EVENTS: SPAM2_STOP_EVENTS[c_id].set()
                if c_id in CUSTOM_SPAM_STOP_EVENTS: CUSTOM_SPAM_STOP_EVENTS[c_id].set()
                if c_id in PIC_SPAM_STOP_EVENTS: PIC_SPAM_STOP_EVENTS[c_id].set()
                if c_id in AUTOREPLY_TARGETS: del AUTOREPLY_TARGETS[c_id]
                if c_id in AUTOREACT_EMOJIS: del AUTOREACT_EMOJIS[c_id]

                send_msg(c_id, "# 🛑 **ALL ACTIONS STOPPED!**", token=self.token, bot_idx=self.bot_index)
                return

            # ==================== ACCESS & SUDO ====================
            if cmd_lower.startswith("access "):
                if auth_id != OWNER_ID:
                    send_msg(c_id, "# ❌ Only owner can grant access.", token=self.token, bot_idx=self.bot_index)
                    return
                parts = cmd_part.split()
                if len(parts) < 2:
                    send_msg(c_id, "# ❌ Usage: *access @user", token=self.token, bot_idx=self.bot_index)
                    return
                user_id = extract_user_id_from_mention(parts[1])
                if not user_id:
                    send_msg(c_id, "# ❌ Invalid mention", token=self.token, bot_idx=self.bot_index)
                    return
                if user_id in SUDO_USERS:
                    send_msg(c_id, "# ℹ️ Already has access", token=self.token, bot_idx=self.bot_index)
                else:
                    SUDO_USERS.append(user_id)
                    save_sudo(SUDO_USERS)
                    send_msg(c_id, f"# ✅ Granted access to {parts[1]}", token=self.token, bot_idx=self.bot_index)
                return

            if cmd_lower.startswith("removeaccess "):
                if auth_id != OWNER_ID:
                    send_msg(c_id, "# ❌ Only owner can revoke access.", token=self.token, bot_idx=self.bot_index)
                    return
                parts = cmd_part.split()
                if len(parts) < 2:
                    send_msg(c_id, "# ❌ Usage: *removeaccess @user", token=self.token, bot_idx=self.bot_index)
                    return
                user_id = extract_user_id_from_mention(parts[1])
                if not user_id:
                    send_msg(c_id, "# ❌ Invalid mention", token=self.token, bot_idx=self.bot_index)
                    return
                if user_id in SUDO_USERS:
                    SUDO_USERS.remove(user_id)
                    save_sudo(SUDO_USERS)
                    send_msg(c_id, f"# ✅ Removed access from {parts[1]}", token=self.token, bot_idx=self.bot_index)
                else:
                    send_msg(c_id, "# ℹ️ User doesn't have access", token=self.token, bot_idx=self.bot_index)
                return

            if cmd_lower == "showusers":
                if not SUDO_USERS:
                    send_msg(c_id, "# ℹ️ No access users added yet.", token=self.token, bot_idx=self.bot_index)
                    return
                user_list = "\n".join([f"# <@{uid}>" for uid in SUDO_USERS])
                send_msg(c_id, f"# 📋 **Access Users:**\n{user_list}", token=self.token, bot_idx=self.bot_index)
                return

            if cmd_lower == "ping":
                start = time.time()
                requests.get("https://discord.com/api/v9/users/@me", headers={"Authorization": self.token}, timeout=5)
                latency = round((time.time() - start) * 1000, 2)
                send_msg(c_id, f"# 🏓 Pong! {latency}ms", token=self.token, bot_idx=self.bot_index)
                return

    def run(self):
        while self.running:
            try:
                self.ws = websocket.WebSocketApp("wss://gateway.discord.gg/?v=9&encoding=json",
                                                 on_message=self.on_message)
                self.ws.run_forever()
            except Exception as e:
                print(f"[!] Bot {self.bot_index + 1} error: {e}")
                time.sleep(5)

# ==================== LAUNCH ALL BOTS ====================
def run_all_bots():
    global TOKENS, BOT_INSTANCES

    print("=" * 60)
    print("      ZAYN BOT ENGINE LOADED")
    print("=" * 60)

    clean_tokens = [t.strip() for t in TOKENS if t and t.strip() and not t.startswith('.')]
    
    if not clean_tokens or clean_tokens[0] == "YOUR_DISCORD_TOKEN_HERE":
        print("[!] Token configure nahi kiya gaya hai! Script ke andar TOKENS variable me token dalein.")
        return

    print(f"[!] Total tokens loaded: {len(clean_tokens)}")

    for i, token in enumerate(clean_tokens):
        bot = DiscordSelfBot(token, i)
        BOT_INSTANCES.append(bot)
        thread = threading.Thread(target=bot.run, daemon=True)
        thread.start()
        time.sleep(1)

    print("[✓] All bots online.")

    try:
        while True:
            time.sleep(1)
    except KeyboardInterrupt:
        print("\n[!] Shutting down all bots...")
        for bot in BOT_INSTANCES:
            bot.running = False

if __name__ == "__main__":
    run_all_bots()
