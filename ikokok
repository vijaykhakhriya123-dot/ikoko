# ==================== BOT CLIENT ====================
class DiscordSelfBot:
    def __init__(self, token, bot_index):
        self.token = token
        self.bot_index = bot_index
        self.ws = None
        self.running = True
        self.user_id = None
        self.current_status = "online"
        self.current_activity = None

    def update_presence(self, status=None, activity_type=0, activity_name=None):
        if status:
            self.current_status = status
        if activity_name:
            self.current_activity = {"name": activity_name, "type": activity_type}
        
        payload = {
            "op": 3,
            "d": {
                "since": 0,
                "activities": [self.current_activity] if self.current_activity else [],
                "status": self.current_status,
                "afk": False
            }
        }
        if self.ws and self.ws.sock and self.ws.sock.connected:
            try:
                self.ws.send(json.dumps(payload))
            except Exception:
                pass

    def join_voice_channel(self, guild_id, channel_id, mute=False, deaf=False):
        payload = {
            "op": 4,
            "d": {
                "guild_id": guild_id,
                "channel_id": channel_id,
                "self_mute": mute,
                "self_deaf": deaf
            }
        }
        if self.ws and self.ws.sock and self.ws.sock.connected:
            try:
                self.ws.send(json.dumps(payload))
                return True
            except Exception:
                return False
        return False

    def leave_voice_channel(self, guild_id):
        return self.join_voice_channel(guild_id, None)

    def on_message(self, ws, message):
        global ACTIVE_NC_CHANNELS, ACTIVE_CUSTOM_NC_CHANNELS
        global ACTIVE_SPAM_CHANNELS, ACTIVE_SPAM2_CHANNELS, ACTIVE_CUSTOM_SPAM_CHANNELS, ACTIVE_PIC_SPAM_CHANNELS
        global SPAM_STOP_EVENTS, SPAM2_STOP_EVENTS, CUSTOM_SPAM_STOP_EVENTS, PIC_SPAM_STOP_EVENTS
        global AUTOREPLY_TARGETS, AUTOREACT_EMOJIS, START_TIME, SUDO_USERS
        global MEGA_SPAM_ACTIVE, MEGA_SPAM_STATS
        global SNIPE_CACHE, MESSAGE_CACHE, AFK_STATE
        global ACTIVE_AUTOPING_CHANNELS
        
        try:
            data = json.loads(message)
        except Exception:
            return

        if data.get("op") == 10:
            heartbeat_interval = data["d"]["heartbeat_interval"] / 1000
            def heartbeat():
                while self.running:
                    time.sleep(heartbeat_interval)
                    try:
                        ws.send(json.dumps({"op": 1, "d": None}))
                    except Exception:
                        break
            threading.Thread(target=heartbeat, daemon=True).start()
            
            ws.send(json.dumps({
                "op": 2,
                "d": {
                    "token": self.token,
                    "properties": {
                        "$os": "Windows",
                        "$browser": "Chrome",
                        "$device": ""
                    }
                }
            }))
            
            try:
                r = requests.get("https://discord.com/api/v9/users/@me", headers={"Authorization": self.token}, timeout=10)
                if r.status_code == 200:
                    self.user_id = r.json().get('id')
            except Exception:
                pass
            print(f"[✓] Bot {self.bot_index + 1} Connected")

        if data.get("t") == "MESSAGE_DELETE":
            d = data.get("d", {})
            m_id = d.get("id")
            c_id = d.get("channel_id")
            if m_id in MESSAGE_CACHE:
                SNIPE_CACHE[c_id] = MESSAGE_CACHE[m_id]

        if data.get("t") == "MESSAGE_CREATE":
            msg = data.get("d", {})
            auth_id = msg.get("author", {}).get("id")
            author_name = msg.get("author", {}).get("username", "Unknown")
            content = msg.get("content", "").strip()
            c_id = msg.get("channel_id")
            m_id = msg.get("id")
            key_suffix = f"{c_id}_{self.token[:10]}"

            if m_id and content:
                MESSAGE_CACHE[m_id] = {
                    "author": author_name,
                    "content": content,
                    "time": datetime.now().strftime("%H:%M:%S")
                }
                if len(MESSAGE_CACHE) > 500:
                    MESSAGE_CACHE.pop(next(iter(MESSAGE_CACHE)))

            if AFK_STATE["is_afk"] and self.user_id:
                mentions = [u.get("id") for u in msg.get("mentions", [])]
                if self.user_id in mentions and auth_id != self.user_id:
                    afk_elapsed = int(time.time() - AFK_STATE["start_time"])
                    reply = f"# 🌙 [AFK] Currently AFK: **{AFK_STATE['reason']}** ({afk_elapsed}s ago)"
                    send_msg(c_id, reply, reply_to=m_id, token=self.token, bot_idx=self.bot_index)

            if c_id in AUTOREPLY_TARGETS:
                if auth_id in AUTOREPLY_TARGETS[c_id]:
                    if self.user_id and auth_id != self.user_id:
                        reply_text = random.choice(REPLY_TEXTS)
                        if not reply_text.startswith("# "):
                            reply_text = "# " + reply_text
                        send_msg(c_id, auto_adjust_message(reply_text, 2000), reply_to=m_id, token=self.token, bot_idx=self.bot_index)

            if c_id in AUTOREACT_EMOJIS:
                emoji = AUTOREACT_EMOJIS[c_id]
                if self.user_id and auth_id != self.user_id:
                    threading.Thread(target=add_reaction, args=(c_id, m_id, emoji, self.token, self.bot_index), daemon=True).start()

            if auth_id != OWNER_ID and auth_id not in SUDO_USERS:
                return

            if not content.startswith(PREFIX):
                return

            cmd_part = content[len(PREFIX):].strip()
            cmd_lower = cmd_part.lower()

            # ==================== SHORT HELP MENU ====================
            if cmd_lower == "help":
                help_msg = (
                    "```yaml\n"
                    "=== COMMANDS LIST ===\n"
                    "• UTILS: *ping | *purge <n> | *snipe | *userinfo [@u] | *serverinfo\n"
                    "• MEDIA: *qr <txt> | *ocr <url> | *screenshot <url> | *tts <ln> <txt> | *poll <Q>|<A>|<B>\n"
                    "• VC   : *joinvc <g_id> <vc_id> | *leavevc <g_id> | *vcmute <g> <vc> | *vcdeaf <g> <vc>\n"
                    "• PING : *ghostping @u | *autopinger @u [delay] | *stopautopinger | *massping @u1 @u2\n"
                    "• STATUS: *setstatus <opt> | *setactivity <type> <txt> | *afk [txt] | *unafk | *tokenstatus\n"
                    "• SPAM : *spam @u | *spam2 <t> | *customspam <t> | *picspam <url> | *megaspam <msg> [n]\n"
                    "• NC   : *nc @u | *customnc <txt> | *stopnc | *stopcustomnc\n"
                    "• STOP : *stopspam | *stopspam2 | *stopcustomspam | *stoppic | *stopmegaspam | *stopall\n"
                    "• SUDO : *access @u | *removeaccess @u | *showusers\n"
                    "```"
                )
                send_msg(c_id, help_msg, token=self.token, bot_idx=self.bot_index)
                return

            # ==================== MEDIA, QR, OCR & SCREENSHOT COMMANDS ====================
            if cmd_lower.startswith("qr "):
                parts = cmd_part.split(maxsplit=1)
                if len(parts) < 2:
                    send_msg(c_id, "# ❌ Usage: *qr <text/link>", token=self.token, bot_idx=self.bot_index)
                    return
                qr_path = generate_qr_code(parts[1])
                if qr_path:
                    send_file(c_id, qr_path, token=self.token, bot_idx=self.bot_index)
                    if os.path.exists(qr_path):
                        os.remove(qr_path)
                else:
                    send_msg(c_id, "# ❌ Failed to generate QR Code.", token=self.token, bot_idx=self.bot_index)
                return

            if cmd_lower.startswith("ocr "):
                parts = cmd_part.split(maxsplit=1)
                if len(parts) < 2:
                    send_msg(c_id, "# ❌ Usage: *ocr <image_url>", token=self.token, bot_idx=self.bot_index)
                    return
                extracted = extract_ocr_text(parts[1])
                send_msg(c_id, f"# 📝 **OCR Result:**\n```\n{extracted}\n```", token=self.token, bot_idx=self.bot_index)
                return

            if cmd_lower.startswith("screenshot "):
