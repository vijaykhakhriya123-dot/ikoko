# ==================== HELPER FUNCTIONS ====================
def send_msg(c_id, text, reply_to=None, token=None, bot_idx=0):
    active_token = token or (TOKENS[0] if TOKENS else None)
    if not active_token:
        return None
    headers = {"Authorization": active_token, "Content-Type": "application/json"}
    payload = {"content": text}
    if reply_to:
        payload["message_reference"] = {"channel_id": c_id, "message_id": reply_to}
    
    try:
        r = requests.post(f"https://discord.com/api/v9/channels/{c_id}/messages",
                          headers=headers, json=payload, timeout=10)
        return r
    except Exception:
        return None

def send_file(c_id, file_path, token=None, bot_idx=0):
    active_token = token or (TOKENS[0] if TOKENS else None)
    if not active_token or not os.path.exists(file_path):
        return None
    headers = {"Authorization": active_token}
    try:
        with open(file_path, 'rb') as f:
            r = requests.post(f"https://discord.com/api/v9/channels/{c_id}/messages",
                              headers=headers, files={"file": f}, timeout=15)
        return r
    except Exception:
        return None

