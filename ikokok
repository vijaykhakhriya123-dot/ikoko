    try:
        timestamp = ((int(snowflake_id) >> 22) + 1420070400000) / 1000
        return datetime.utcfromtimestamp(timestamp).strftime('%Y-%m-%d %H:%M:%S UTC')
    except Exception:
        return "Unknown"

def pad_to_length(text, max_len):
    if len(text) >= max_len:
        return text[:max_len]
    padded = text
    while len(padded) < max_len:
        remaining = max_len - len(padded) - 1
        if remaining <= 0:
            padded += ' '
            break
        padded += ' ' + text[:remaining]
    return padded[:max_len]

def auto_adjust_message(text, max_len=2000):
    if len(text) <= max_len:
        return text
    text = ' '.join(text.split())
    if len(text) <= max_len:
        return text
    return text[:max_len]

