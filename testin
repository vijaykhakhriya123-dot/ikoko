-- ============================================
-- DEEP SCANNER
-- ============================================
local function isURL(str)
    if type(str) ~= "string" then return false end
    return str:match("^https?://") ~= nil
end

local function containsFirebase(str)
    if type(str) ~= "string" then return false end
    local lower = str:lower()
    return lower:find("firebase") or lower:find("database") or 
           lower:find("rtdb") or (lower:find("google") and lower:find("com"))
end

local function addFinding(category, path, value)
    if type(value) ~= "string" then return end
    table.insert(FOUND_SECRETS, {
        category = category,
        path = path,
        value = value,
        time = tick() - scanStart
    })
    log(string.format("📦 [%s] %s = %s", category, path, value:sub(1, 60)))
end

