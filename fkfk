-- VECTOR 6: HTTP Service Hook Test
-- ============================================
print("\n[6/10] Testing HTTP service hooks...")

local HttpService = game:GetService("HttpService")
local capturedBefore = #FOUND_URLS

-- Try to hook and capture
local originalRequest = HttpService.RequestAsync
local success = pcall(function()
    HttpService.RequestAsync = function(self, request)
        if type(request) == "table" and request.Url then
            addFinding("HTTP_HOOK", "RequestAsync", request.Url)
            table.insert(FOUND_URLS, request.Url)
        end
        return originalRequest(self, request)
    end
end)

if success then
    print("    ⚠️ HTTP Service hook successful - waiting for requests...")
    wait(2)
    HttpService.RequestAsync = originalRequest
else
    print("    ✅ HTTP Service protected from hooking")
end

