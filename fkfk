-- ============================================
print("\n[10/10] Bytecode constant extraction...")

for _, obj in ipairs(game:GetDescendants()) do
    if obj:IsA("ModuleScript") then
        local success, module = pcall(require, obj)
        if success and type(module) == "function" then
            for i = 1, 20 do
                local ok, const = pcall(function()
                    return debug.getconstant(module, i)
