                if ok and type(const) == "string" then
                    if isURL(const) or (containsFirebase(const) and #const > 10) then
                        addFinding("CONSTANT", obj.Name.."["..i.."]", const)
                        if isURL(const) then table.insert(FOUND_URLS, const) end
                    end
                end
            end
        end
    end
end

